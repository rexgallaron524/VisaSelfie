# Copy to .env on a NEW deployment host. Preserve credentials on an existing host.
POSTGRES_USER=visaselfie
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=visaselfie
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-different-long-random-storage-secret
APP_ENV=production
FRONTEND_PUBLIC_URL=https://your-registered-hostname.example
ALLOWED_ORIGINS=https://your-registered-hostname.example
COOKIE_SECURE=true
FORWARDED_ALLOW_IPS=
