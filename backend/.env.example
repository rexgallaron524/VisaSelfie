# For running the API outside Docker. Use the same database credentials as .env.
DATABASE_URL=postgresql+psycopg://visaselfie:replace-with-a-long-random-database-password@localhost:5432/visaselfie
APP_ENV=development
FRONTEND_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
# Keep empty with the Next.js API proxy; trust only known direct proxies otherwise.
FORWARDED_ALLOW_IPS=
SESSION_HOURS=8
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=replace-with-your-storage-access-key
S3_SECRET_KEY=replace-with-your-storage-secret
S3_BUCKET=visa-selfie-videos
