# Local development only. Copy this file to .env and replace the credentials.
POSTGRES_USER=visaselfie
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=visaselfie
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-different-long-random-storage-secret
APP_ENV=development
FRONTEND_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
# Optional: comma-separated trusted proxy IPs/CIDRs. Empty ignores forwarded headers.
FORWARDED_ALLOW_IPS=
